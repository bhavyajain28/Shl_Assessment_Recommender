# Choose one: groq (free tier, recommended), openrouter, or openai
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here

# Optional overrides. Leave blank to use the provider's default base_url/model.
LLM_BASE_URL=
LLM_MODEL=

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=18
LLM_MAX_RETRIES=2

# Local, no API key needed (downloaded from HuggingFace on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LOG_LEVEL=INFO
